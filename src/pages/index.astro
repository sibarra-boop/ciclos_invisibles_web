---
import HomeDiagram from "../components/sections/HomeDiagram.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Ciclos Invisibles">
  <main class="hero">
    <section class="intro">
      <img src="/img/logo_ciclos.svg" alt="Ciclos Invisibles" class="brand-logo" />
      <h2>Todo lo que sentimos tiene contexto.</h2>
      <p>Explora cómo se relacionan nuestros procesos, emociones y el entorno que nos rodea.</p>
      <p>Elige un tema para descubrir más.</p>
    </section>
    <HomeDiagram />
  </main>
</BaseLayout>
