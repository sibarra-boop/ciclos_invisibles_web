---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { internos } from "../../../data/internos";
import ovulationDiagram from "../../../../img/internos/ovulacion.svg?raw";
import "../../../../css/ovulacion.css";

const cyclePhases = [
  internos["fase-menstrual"],
  internos["fase-folicular"],
  internos.ovulacion,
  internos["fase-lutea"],
];
---

<BaseLayout
  title={`${internos.ovulacion.title} | Ciclos Invisibles`}
  description={internos.ovulacion.description}
  bodyClass="cycle-phase-page"
>
  <main class="ovulation">
    <section class="ovulation__hero" aria-labelledby="ovulation-title">
      <div class="ovulation__intro">
        <p class="ovulation__eyebrow">Fases del ciclo</p>
        <h1 id="ovulation-title">
          {internos.ovulacion.title}
        </h1>
        <p class="ovulation__description">
          {internos.ovulacion.description} Es parte de nuestro proceso hormonal que conecta distintas señales.
        </p>
      </div>

      <figure class="ovulation__diagram">
        <Fragment set:html={ovulationDiagram} />
      </figure>

      <aside class="ovulation__feelings" aria-labelledby="ovulation-feelings-title">
        <h2 id="ovulation-feelings-title">¿Cómo podríamos sentirnos?</h2>
        <ul>
          <li>Cambios de energía</li>
          <li>Cambios en el deseo</li>
          <li>Variaciones del ánimo</li>
          <li>Mayor sensibilidad</li>
          <li>Molestias leves</li>
        </ul>
      </aside>
    </section>

    <section class="ovulation__insights" aria-label="Más información sobre la ovulación">
      <article class="ovulation__influence">
        <h2>¿Qué más influye?</h2>
        <p>
          La experiencia de esta fase también puede variar por nuestro sueño, el estrés, la alimentación y nuestro entorno.
        </p>
      </article>

      <div class="ovulation__notes">
        <article class="ovulation__phrases">
          <h2>Frases que escuchamos</h2>
          <ul>
            <li>“Solo andas así porque estás ovulando.”</li>
            <li>“En esta fase siempre tienes más ganas.”</li>
          </ul>
        </article>
        <article class="ovulation__fact">
          <h2>Sabías que...</h2>
          <p>
            La ovulación puede coincidir con cambios corporales, pero no determina cómo sentimos ni cómo actuamos.
          </p>
        </article>
      </div>

      <a class="ovulation__explore" href="#cycle-phases">
        <span>Explora<br />más relaciones</span>
        <span class="ovulation__arrow" aria-hidden="true">→</span>
      </a>
    </section>

    <nav class="cycle" id="cycle-phases" aria-label="Fases del ciclo menstrual">
      <h2 class="cycle__title">El ciclo</h2>
      <ol class="cycle__list">
        {cyclePhases.map((phase) => (
          <li class:list={["cycle__phase", { "cycle__phase--current": phase.slug === internos.ovulacion.slug }]}>
            <a href={phase.href} aria-current={phase.slug === internos.ovulacion.slug ? "page" : undefined}>
              <span class="cycle__dot" aria-hidden="true"></span>
              <span>{phase.title === "Fase menstrual" ? "Menstruación" : phase.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </main>
</BaseLayout>
