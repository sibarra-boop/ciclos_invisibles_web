---
import type { InternalPhaseContent } from "../data/types";
import { internos } from "../data/internos";
import BaseLayout from "./BaseLayout.astro";
import "../../css/ovulacion.css";

interface Props {
  topic: InternalPhaseContent;
  inlineDiagram?: string;
}

const { topic, inlineDiagram } = Astro.props;
const pageTitle = topic.displayTitle ?? topic.title;
const phaseLabel = topic.slug === "ovulacion" ? "la ovulación" : `la ${topic.title.toLowerCase()}`;
const cyclePhases = [
  internos["fase-menstrual"],
  internos["fase-folicular"],
  internos.ovulacion,
  internos["fase-lutea"],
];
---

<BaseLayout
  title={`${pageTitle} | Ciclos Invisibles`}
  description={topic.description}
  bodyClass="cycle-phase-page"
>
  <main class="ovulation">
    <section class="ovulation__hero" aria-labelledby={`${topic.slug}-title`}>
      <div class="ovulation__intro">
        <p class="ovulation__eyebrow">Fases del ciclo</p>
        <h1 id={`${topic.slug}-title`}>{pageTitle}</h1>
        <p class="ovulation__description">{topic.description}</p>
      </div>

      <figure class="ovulation__diagram">
        {inlineDiagram ? (
          <Fragment set:html={inlineDiagram} />
        ) : (
          <img src={topic.image} alt={topic.imageAlt} />
        )}
      </figure>

      <aside class="ovulation__feelings" aria-labelledby={`${topic.slug}-feelings-title`}>
        <h2 id={`${topic.slug}-feelings-title`}>¿Cómo podríamos sentirnos?</h2>
        <ul>
          {topic.feelings.map((feeling) => <li>{feeling}</li>)}
        </ul>
      </aside>
    </section>

    <section
      class="ovulation__insights"
      aria-label={`Más información sobre ${phaseLabel}`}
    >
      <article class="ovulation__influence">
        <h2>¿Qué más influye?</h2>
        <p>{topic.influence}</p>
      </article>

      <div class="ovulation__notes">
        <article class="ovulation__phrases">
          <h2>Frases que escuchamos</h2>
          <ul>
            {topic.phrases.map((phrase) => <li>{phrase}</li>)}
          </ul>
        </article>
        <article class="ovulation__fact">
          <h2>Sabías que...</h2>
          <p>{topic.fact}</p>
        </article>
      </div>

      <a class="ovulation__explore" href="/">
        <img class="ovulation__explore-graphic" src={topic.exploreImage} alt="" aria-hidden="true" />
        <span>Explora<br />más relaciones</span>
        <span class="ovulation__arrow" aria-hidden="true">→</span>
      </a>
    </section>

    <nav class="cycle" id="cycle-phases" aria-label="Fases del ciclo menstrual">
      <h2 class="cycle__title">El ciclo</h2>
      <ol class="cycle__list">
        {cyclePhases.map((phase) => (
          <li class:list={["cycle__phase", { "cycle__phase--current": phase.slug === topic.slug }]}>
            <a href={phase.href} aria-current={phase.slug === topic.slug ? "page" : undefined}>
              <span class="cycle__dot" aria-hidden="true"></span>
              <span class="cycle__label">{phase.displayTitle ?? phase.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </main>
</BaseLayout>
