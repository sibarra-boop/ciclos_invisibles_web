    <path id="ci-logo" class="st3" d="M409.43,458.05c.04,2.9,3.42,4.46,5.67,2.62,5.34-4.38,2.82-12.04,7.64-12.21,2.84-.1,4.8.23,6.5,1.97,1.62,1.66,2.5,4.05,2.29,6.83-.96,12.62-19.56,17.1-33.9,14.58-13.75-2.41-24.94-11.39-29.68-24.7-4.42-12.41-1.51-26.45,7.01-36.41,7.33-8.58,16.82-13.54,27.84-15.42,7.54-1.28,15.51-1.05,22.01,2.79,4.04,2.39,5.05,7.09,2.72,10.75-.9,16.56-11.18,29.21-17.35,45.03-.51,1.31-.77,2.74-.75,4.16ZM413.51,463.22c-3,1.67-6.28.42-8.18-1.44-6.13-6.01-.08-16.51,5.47-23.91,6.34-8.45,14.53-17.5,14.56-27.29-3.7.51-7.38-1.08-6.99-4.32.46-3.82-.64-6.94-4.74-8.33-13.27-4.5-27.5,3.09-32.16,16.77-4.63,13.59-4.13,28.91,1.95,42.21,5.27,11.54,21.35,18.2,35.15,11.29,5.21-2.61,9.12-9.21,5.32-13.87-.5-.61-2.81-.68-3.27.1-1.66,2.82-3.9,7.01-7.1,8.79Z" />
