<script>
  // Mantiene cada etiqueta pegada a su círculo mientras los grupos giran.
  const chart = document.getElementById("chart");

  if (chart) {
    const pairs = Array.from(chart.querySelectorAll<HTMLElement>(".chart-link[data-target]"))
      .map((label) => ({ label, circle: document.getElementById(label.dataset.target ?? "") }))
      .filter((pair): pair is { label: HTMLElement; circle: HTMLElement } => pair.circle !== null);

    const update = () => {
      const chartRect = chart.getBoundingClientRect();
      for (const { label, circle } of pairs) {
        // Centro del círculo relativo a #chart. Un círculo girado conserva su caja,
        // así que el centro de getBoundingClientRect es el centro real.
        // El CSS (translate -50% -50%) centra la etiqueta sobre este punto.
        const rect = circle.getBoundingClientRect();
        label.style.left = `${rect.left + rect.width / 2 - chartRect.left}px`;
        label.style.top = `${rect.top + rect.height / 2 - chartRect.top}px`;
      }
      requestAnimationFrame(update);
    };

    requestAnimationFrame(update);
  }
</script>
