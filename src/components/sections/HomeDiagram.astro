---
import { externalRoutes, internalRoutes } from "../../data/routes";
import type { TopicRoute } from "../../data/types";

/*
 * Diagrama de la home (portado de /index.html + /js/diagrama-nav.js).
 * Los grupos #internos y #externos giran con CSS (css/style.css, @keyframes spin).
 * Cada círculo del SVG es el link real; las etiquetas .chart-link son decorativas
 * y un script las centra en cada frame sobre su círculo mientras gira.
 */

const bySlug = (routes: TopicRoute[], slug: string) => {
  const route = routes.find((item) => item.slug === slug);
  if (!route) throw new Error(`HomeDiagram: no existe la ruta "${slug}" en routes.ts`);
  return route;
};

// id del círculo en el SVG → ruta y subtítulo
const internos = {
  ovulacion: bySlug(internalRoutes, "ovulacion"),
  folicular: bySlug(internalRoutes, "fase-folicular"),
  lutea: bySlug(internalRoutes, "fase-lutea"),
  menstrual: bySlug(internalRoutes, "fase-menstrual"),
};

const externos = {
  tabues: { route: bySlug(externalRoutes, "tabues"), subtitle: "Lo que nos enseñaron a callar" },
  sueno: { route: bySlug(externalRoutes, "sueno"), subtitle: "Descanso y energía" },
  info: { route: bySlug(externalRoutes, "informacion"), subtitle: "Educación, acceso y salud" },
  entorno: { route: bySlug(externalRoutes, "entorno"), subtitle: "Trabajo, tiempo y condiciones de vida" },
  estres: { route: bySlug(externalRoutes, "estres"), subtitle: "Carga mental y emociones" },
  auto: { route: bySlug(externalRoutes, "autopercepcion"), subtitle: "Hábitos, alimentación y necesidades de nuestro cuerpo" },
};
---

<section id="chart" aria-label="Diagrama de ciclos">
  {Object.entries(internos).map(([id, route]) => (
    <div class="chart-link" data-target={id} aria-hidden="true">
      <span>{route.title}</span>
    </div>
  ))}
  {Object.entries(externos).map(([id, { route, subtitle }]) => (
    <div class="chart-link" data-target={id} aria-hidden="true">
      {route.title}
      <p class="chart-1">{subtitle}</p>
    </div>
  ))}

  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 817.05 871.18">
